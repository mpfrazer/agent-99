# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# ── LLM providers ────────────────────────────────────────────────────────────
# Required when using any anthropic/* model (e.g. anthropic/claude-sonnet-4-6)
ANTHROPIC_API_KEY=sk-ant-...

# Required when using any openai/* model (e.g. openai/gpt-4o)
OPENAI_API_KEY=sk-...

# ── Web search ────────────────────────────────────────────────────────────────
# Brave Search API — free tier at https://api.search.brave.com/ (2000 req/month)
# Used by the web_search tool.
BRAVE_SEARCH_API_KEY=BSA...

# Google Custom Search (site-restricted only — whole-web search is deprecated)
# https://developers.google.com/custom-search/v1/introduction
GOOGLE_CSE_API_KEY=...
GOOGLE_CSE_ID=...

# ── Server URLs ───────────────────────────────────────────────────────────────
# Override these when running behind a reverse proxy or on a non-default port.
# Defaults: API = http://localhost:8000, Web = http://localhost:3000
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
